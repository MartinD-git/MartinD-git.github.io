---
import { Image } from "astro:assets";
import { createSatteriMarkdownProcessor } from "@astrojs/markdown-satteri";
import portrait from "../assets/portrait.webp";
import Icon from "../components/Icon.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
import { site } from "../data/site";
import { skills } from "../data/skills";
import { courses } from "../data/courses";
import "../styles/global.css";

const markdown = await createSatteriMarkdownProcessor({ syntaxHighlight: false });
const [introduction, biography, philosophy] = await Promise.all(
  [site.introduction, site.biography, site.philosophy].map((text) => markdown.render(text))
);

const updated = new Date(`${site.updated}T12:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name} — AI & Robotics</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#f6f3ec" />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${site.name} — AI & Robotics`} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={Astro.site} />
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <aside class="sidebar" aria-label="Site navigation">
      <a class="wordmark" href="#home" aria-label="Martin Daigne — home">
        md<span>.</span>
      </a>
      <nav aria-label="Main navigation">
        <ul>
          {[
            { id: "home", label: "Home" },
            { id: "projects", label: "Projects" },
            { id: "skills", label: "Skills" },
          ].map(({ id, label }) => (
            <li>
              <a href={`#${id}`} class:list={["nav-link", { "is-active": id === "home" }]} aria-current={id === "home" ? "location" : undefined}>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="sidebar-bottom">
        <div class="social-links">
          <a href={site.linkedin} class="social-link" target="_blank" rel="noreferrer" aria-label="LinkedIn (opens in a new tab)" title="LinkedIn">
            <Icon name="linkedin" />
          </a>
          <a href={site.github} class="social-link" target="_blank" rel="noreferrer" aria-label="GitHub (opens in a new tab)" title="GitHub">
            <Icon name="github" />
          </a>
          <a href={site.cv} class="social-link" download aria-label="Download CV (PDF)" title="Download CV (PDF)">
            <Icon name="cv" />
          </a>
        </div>
      </div>
    </aside>

    <main id="main" class="main-content">
      <section id="home" class="home-section" aria-labelledby="home-heading" data-section>
        <div class="home-copy">
          <p class="position">
            <span aria-hidden="true"></span>
            {site.position}
          </p>
          <h1 id="home-heading">
            Martin
            <br />
            Daigne<span class="accent">.</span>
          </h1>
          <div class="home-introduction" set:html={introduction.code} />
          <div class="home-biography" set:html={biography.code} />
          <div class="home-philosophy" set:html={philosophy.code} />
          <a class="text-link" href="#projects">
            Explore my work<span aria-hidden="true">↘</span>
          </a>
        </div>
        <figure class="portrait">
          <Image
            src={portrait}
            alt="Illustrated portrait used by Martin Daigne"
            widths={[320, 640, 960]}
            sizes="(max-width: 540px) 30vw, (max-width: 900px) 180px, (max-width: 1100px) 30vw, 365px"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </section>

      <ProjectGallery />

      <section id="skills" class="skills-section" aria-labelledby="skills-heading" data-section>
        <div class="section-heading">
          <div>
            <h2 id="skills-heading">
              Skills & tools<span class="accent">.</span>
            </h2>
          </div>
        </div>
        <div class="skills-layout">
          <div class="skill-groups">
            {skills.map((group) => (
              <div class="skill-group">
                <h3>{group.title}</h3>
                <ul>
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <div class="courses-panel">
            <div class="courses-heading">
              <h3 id="courses-heading">Courses</h3>
              <span>EPFL & TU Delft</span>
            </div>
            <div class="courses-scroll" tabindex={0} role="region" aria-labelledby="courses-heading">
              {courses.map((group) => (
                <div class="course-group">
                  <h4>{group.title}</h4>
                  <ul>
                    {group.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <footer class="footer">
        <p>
          © {site.name}
          <span aria-hidden="true"> · </span>Updated <time datetime={site.updated}>{updated}</time>
        </p>
        {(site.note || site.footerLinks.length > 0) && (
          <div>
            {site.note && <p>{site.note}</p>}
            {site.footerLinks.map((link) => (
              <a href={link.url}>{link.label}</a>
            ))}
          </div>
        )}
      </footer>
    </main>
    <script>
      import { setupPortfolio } from "../scripts/portfolio";
      setupPortfolio();
    </script>
  </body>
</html>
